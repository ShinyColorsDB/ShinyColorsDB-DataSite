{
  "version": 2,
  "name": "shiny-colors-db-data-site",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.shinycolors.moe/info/sitelist"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/ShinyColorsDB-DataSite/**"
    }
  }
}
